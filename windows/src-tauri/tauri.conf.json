{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miku Desktop",
  "version": "0.1.0",
  "identifier": "com.qimake.MikuDesktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
