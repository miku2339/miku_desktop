      "../../Wallpaper/assets/companion-model/eyeM2.bmp": "Wallpaper/assets/companion-model/eyeM2.bmp",
      "../../Wallpaper/assets/companion-model/readme.txt": "Wallpaper/assets/companion-model/readme.txt",
      "../../Wallpaper/assets/companion-model/readme_miku_v2.txt": "Wallpaper/assets/companion-model/readme_miku_v2.txt",
      "../../Wallpaper/assets/companion-model/ASSET-NOTICE.txt": "Wallpaper/assets/companion-model/ASSET-NOTICE.txt",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
